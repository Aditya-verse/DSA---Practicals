
#include <iostream>
using namespace std;

struct Node {
    int roll;
    Node *next;
};

// Insert a new node
void insert(Node *&head, int x) {
    Node *n = new Node{x, NULL};

    if (head == NULL)
        head = n;
    else {
        Node *t = head;

        while (t->next)
            t = t->next;

        t->next = n;
    }
}

// Search for a roll number
bool find(Node *head, int x) {
    while (head) {
        if (head->roll == x)
            return true;

        head = head->next;
    }

    return false;
}

// Display linked list
void display(Node *head) {
    while (head) {
        cout << head->roll << " ";
        head = head->next;
    }

    cout << endl;
}

int main() {
    Node *A = NULL, *B = NULL;

    int total, n, m, x;
    int countUnion = 0;

    cout << "Enter total students in class: ";
    cin >> total;

    cout << "Enter number who like Vanilla: ";
    cin >> n;

    cout << "Enter roll numbers: ";

    for (int i = 0; i < n; i++) {
        cin >> x;
        insert(A, x);
    }

    cout << "Enter number who like Butterscotch: ";
    cin >> m;

    cout << "Enter roll numbers: ";

    for (int i = 0; i < m; i++) {
        cin >> x;
        insert(B, x);
    }

    cout << "\nVanilla: ";
    display(A);

    cout << "Butterscotch: ";
    display(B);

    // 1. Either Vanilla or Butterscotch or Both
    cout << "\n1. Either Vanilla or Butterscotch or Both: ";

    display(A);

    Node *t = B;

    while (t) {
        if (!find(A, t->roll))
            cout << t->roll << " ";

        t = t->next;
    }

    cout << endl;

    // 2. Students who like Both
    cout << "2. Both Vanilla and Butterscotch: ";

    t = A;

    while (t) {
        if (find(B, t->roll))
            cout << t->roll << " ";

        t = t->next;
    }

    cout << endl;

    // 3. Only Vanilla
    cout << "3. Only Vanilla: ";

    t = A;

    while (t) {
        if (!find(B, t->roll))
            cout << t->roll << " ";

        t = t->next;
    }

    cout << endl;

    // 4. Only Butterscotch
    cout << "4. Only Butterscotch: ";

    t = B;

    while (t) {
        if (!find(A, t->roll))
            cout << t->roll << " ";

        t = t->next;
    }

    cout << endl;

    // Count students in Union
    t = A;

    while (t) {
        countUnion++;
        t = t->next;
    }

    t = B;

    while (t) {
        if (!find(A, t->roll))
            countUnion++;

        t = t->next;
    }

    // 5. Students who like neither
    cout << "5. Number who like neither: "
         << total - countUnion << endl;

    return 0;
}
