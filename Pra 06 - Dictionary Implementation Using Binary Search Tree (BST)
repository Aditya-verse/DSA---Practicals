
#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

struct Node {
    string key, meaning;
    Node *left, *right;

    Node(string k, string m) {
        key = k;
        meaning = m;
        left = right = nullptr;
    }
};

// Insert a new keyword
Node* insert(Node* r, string k, string m) {
    if (!r) return new Node(k, m);

    if (k < r->key)
        r->left = insert(r->left, k, m);
    else if (k > r->key)
        r->right = insert(r->right, k, m);
    else
        cout << "\nKeyword already exists.\n";

    return r;
}

// Search for a keyword
Node* search(Node* r, string k) {
    if (!r || r->key == k)
        return r;

    return k < r->key
        ? search(r->left, k)
        : search(r->right, k);
}

// Find minimum node
Node* minNode(Node* r) {
    while (r && r->left)
        r = r->left;

    return r;
}

// Delete a keyword
Node* deleteKey(Node* r, string k) {
    if (!r) return nullptr;

    if (k < r->key)
        r->left = deleteKey(r->left, k);
    else if (k > r->key)
        r->right = deleteKey(r->right, k);
    else {
        if (!r->left || !r->right) {
            Node* t = r->left ? r->left : r->right;
            delete r;
            return t;
        }

        Node* t = minNode(r->right);
        r->key = t->key;
        r->meaning = t->meaning;
        r->right = deleteKey(r->right, t->key);
    }

    return r;
}

// Display in ascending or descending order
void display(Node* r, bool asc) {
    if (!r) return;

    display(asc ? r->left : r->right, asc);

    cout << " " << r->key << " : "
         << r->meaning << '\n';

    display(asc ? r->right : r->left, asc);
}

// Calculate BST height
int height(Node* r) {
    if (!r) return 0;

    return 1 + max(height(r->left),
                   height(r->right));
}

int main() {
    Node* root = nullptr;
    int ch;
    string k, m;

    do {
        cout << "\n========================================\n";
        cout << "       DICTIONARY USING BST\n";
