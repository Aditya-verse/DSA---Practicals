        cout << " 3. Update Meaning\n";
        cout << " 4. Display Ascending Order\n";
        cout << " 5. Display Descending Order\n";
        cout << " 6. Find Maximum Comparisons\n";
        cout << " 7. Search Keyword\n";
        cout << " 8. Exit\n";
        cout << "----------------------------------------\n";
        cout << " Enter your choice: ";
        cin >> ch;

        switch (ch) {
            case 1: {
                cout << "\n[ADD KEYWORD]\n";
                cout << "Enter keyword: ";
                cin >> k;

                if (search(root, k)) {
                    cout << "Keyword already exists.\n";
                    break;
                }

                cout << "Enter meaning: ";
                cin >> ws;
                getline(cin, m);

                root = insert(root, k, m);
                cout << "Keyword added successfully.\n";
                break;
            }

            case 2:
                cout << "\n[DELETE KEYWORD]\n";
                cout << "Enter keyword: ";
                cin >> k;

                if (!search(root, k))
                    cout << "Keyword not found.\n";
                else {
                    root = deleteKey(root, k);
                    cout << "Keyword deleted successfully.\n";
                }
                break;

            case 3: {
                cout << "\n[UPDATE MEANING]\n";
                cout << "Enter keyword: ";
                cin >> k;

                Node* t = search(root, k);

                if (!t)
                    cout << "Keyword not found.\n";
                else {
                    cout << "Enter new meaning: ";
                    cin >> ws;
                    getline(cin, t->meaning);
                    cout << "Meaning updated successfully.\n";
                }
                break;
            }

            case 4:
            case 5:
                cout << (ch == 4
                    ? "\n[ASCENDING ORDER]\n"
                    : "\n[DESCENDING ORDER]\n");

                cout << "----------------------------------------\n";

                if (!root)
                    cout << "Dictionary is empty.\n";
                else
                    display(root, ch == 4);
                break;

            case 6:
                cout << "\n[HEIGHT OF BST]\n";
                cout << "Maximum comparisons: "
                     << height(root) << '\n';
                break;

            case 7: {
                cout << "\n[SEARCH KEYWORD]\n";
                cout << "Enter keyword: ";
                cin >> k;

                Node* t = search(root, k);

                if (!t)
                    cout << "Keyword not found.\n";
                else
                    cout << "Meaning: " << t->meaning << '\n';
                break;
            }

            case 8:
                cout << "\nDictionary closed successfully.\n";
                break;

            default:
                cout << "\nInvalid choice! Please select 1-8.\n";
        }

    } while (ch != 8);

    return 0;
}
