
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node *left, *right;
};

// Insert a new node
Node* insert(Node* root, int x) {
    if (root == NULL) {
        Node* p = new Node;
        p->data = x;
        p->left = p->right = NULL;
        return p;
    }

    if (x < root->data)
        root->left = insert(root->left, x);
    else if (x > root->data)
        root->right = insert(root->right, x);

    return root;
}

// Find height (longest path from root)
int height(Node* root) {
    if (root == NULL)
        return 0;

    int l = height(root->left);
    int r = height(root->right);

    return 1 + (l > r ? l : r);
}

// Find minimum data value
int minimum(Node* root) {
    if (root == NULL)
        return -1;

    while (root->left != NULL)
        root = root->left;

    return root->data;
}

// Display BST using inorder traversal
void inorder(Node* root) {
    if (root != NULL) {
        inorder(root->left);
        cout << root->data << " ";
        inorder(root->right);
    }
}

int main() {
    Node* root = NULL;
    int n, x, ch;

    cout << "====================================\n";
    cout << "          BINARY SEARCH TREE\n";
    cout << "====================================\n";

    cout << "Enter number of nodes: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of nodes!\n";
        return 0;
    }

    cout << "Enter node values: ";

    for (int i = 0; i < n; i++) {
        cin >> x;
        root = insert(root, x);
    }

    do {
        cout << "\n============= BST MENU =============\n";
        cout << "1. Insert a new node\n";
        cout << "2. Find longest path from root\n";
        cout << "3. Find minimum data value\n";
        cout << "4. Display BST (Inorder)\n";
        cout << "0. Exit\n";
        cout << "====================================\n";

        cout << "Enter your choice: ";
        cin >> ch;

        switch (ch) {
            case 1:
                cout << "Enter value to insert: ";
                cin >> x;

                root = insert(root, x);

                cout << "Node inserted successfully.\n";
                cout << "BST: ";
                inorder(root);
                cout << "\n";
                break;

            case 2:
                cout << "Nodes in longest path from root: "
                     << height(root) << "\n";
                break;

            case 3:
                if (root == NULL)
                    cout << "BST is empty.\n";
                else
                    cout << "Minimum data value: "
                         << minimum(root) << "\n";
                break;

            case 4:
                cout << "BST (Inorder): ";
                inorder(root);
                cout << "\n";
                break;

            case 0:
                cout << "Program terminated successfully.\n";
                break;

            default:
                cout << "Invalid choice! Please try again.\n";
        }

    } while (ch != 0);

    return 0;
}
